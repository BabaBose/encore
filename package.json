{
  "name": "book-the-act",
  "version": "0.1.0",
  "private": true,
  "description": "Book the Act — a two-sided marketplace connecting venues with entertainers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:push && next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "db:push": "tsx scripts/db-deploy.ts",
    "db:reset": "tsx scripts/db-deploy.ts --force-seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
